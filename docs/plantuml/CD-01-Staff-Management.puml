@startuml CD-01-Staff-Management

' ============================================================
' Class Diagram — Staff Management
' Feature: Admin Staff Account Management
' Architecture: Router → Middleware → Controller → Service → Repository → Model
' ============================================================

!pragma useStickyOnly true
skinparam classAttributeIconSize 0
skinparam padding 3
skinparam nodesep 60
skinparam ranksep 50
skinparam linetype ortho

title CD-01 — Staff Management (RBAC + Email)

' ---------- Middlewares ----------
class AuthMiddleware {
  + authenticate(req, res, next)
}

class PermissionMiddleware {
  + requirePermission(...perms) : Function
}

class ValidateMiddleware {
  + validate(schema, source) : Function
}

class ErrorMiddleware {
  + notFoundHandler()
  + errorHandler(err, req, res, next)
}

' ---------- Staff module ----------
class StaffRouter {
  + POST /
  + GET /
  + GET /:id
  + PUT /:id
  + PATCH /:id/role
  + PATCH /:id/status
}

class StaffController {
  + create(req, res, next)
  + list(req, res, next)
  + getOne(req, res, next)
  + update(req, res, next)
  + assignRole(req, res, next)
  + updateStatus(req, res, next)
}

class StaffService {
  + createStaff(input, actor)
  + listStaff({page, limit})
  + getStaff(id)
  + updateStaff(id, patch)
  + assignRole(id, roleId)
  + setActive(id, isActive)
}

class StaffValidator {
  + createStaffSchema
  + updateStaffSchema
  + assignRoleSchema
  + updateStatusSchema
  + staffIdParamSchema
}

' ---------- Repositories ----------
class UserRepository {
  + findByEmail(email)
  + findByPhone(phone)
  + findByUsername(username)
  + findById(id)
  + findAll({page, limit})
  + create(doc)
  + updateById(id, update)
  + setRole(id, roleId)
  + setActive(id, isActive)
}

class RoleRepository {
  + findByName(name)
  + findById(id)
  + findAll()
  + create(doc)
}

' ---------- Models ----------
class User {
  - _id : ObjectId
  - fullName : String
  - email : String
  - phone : String
  - address : String
  - role : ObjectId
  - passwordHash : String
  - isActive : Boolean
  + toSafeJSON()
  + verifyPassword(plain)
}

class Role {
  - _id : ObjectId
  - name : String
  - description : String
  - permissions : ObjectId[]
  - isSystem : Boolean
}

class Permission {
  - _id : ObjectId
  - name : String
  - resource : String
  - action : String
}

' ---------- Email ----------
class EmailService {
  + sendMail({to, subject, html, text})
  + sendStaffAccountCreatedEmail({to, fullName, roleName, loginUrl, temporaryPassword})
}

' ---------- Auth ----------
class AuthRouter {
  + POST /login
  + POST /refresh
}

class AuthController {
  + login(req, res, next)
  + refresh(req, res, next)
}

class AuthService {
  + login({email, password})
  + refresh(token)
}

class JwtUtil {
  + signAccessToken(payload)
  + signRefreshToken(payload)
  + verifyAccessToken(token)
  + verifyRefreshToken(token)
}

' ---------- Relationships ----------
StaffRouter ..> AuthMiddleware
StaffRouter ..> PermissionMiddleware
StaffRouter ..> ValidateMiddleware
StaffRouter ..> StaffController
StaffController ..> StaffService
StaffService ..> UserRepository
StaffService ..> RoleRepository
StaffService ..> EmailService
UserRepository ..> User
RoleRepository ..> Role
Role ..> Permission

AuthRouter ..> AuthController
AuthController ..> AuthService
AuthService ..> UserRepository
AuthService ..> JwtUtil
AuthService ..> User

ErrorMiddleware ..> ApiError
AuthMiddleware ..> JwtUtil
AuthMiddleware ..> User

@enduml
