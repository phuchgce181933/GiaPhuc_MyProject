@startuml SD-04-Assign-Role

' ============================================================
' Sequence Diagram — Assign Role
' UC: UC-04 Assign Role
' ============================================================

!pragma useStickyOnly true
skinparam classAttributeIconSize 0
skinparam padding 3
skinparam nodesep 60
skinparam ranksep 50
skinparam linetype ortho

title SD-04 — Assign Role (UC-04)

actor "User with ASSIGN_ROLE" as A
participant "React\nStaffEditPage" as React
participant "Axios API" as Axios
participant "StaffRouter" as Router
participant "AuthMiddleware" as AuthMw
participant "PermissionMiddleware\n(ASSIGN_ROLE)" as PermMw
participant "ValidateMiddleware\n(assignRoleSchema)" as ValMw
participant "StaffController" as Ctrl
participant "StaffService" as Svc
participant "RoleRepository" as RoleRepo
participant "UserRepository" as UserRepo
database "MongoDB" as DB

== Pre-fetch available roles ==
React -> Axios : GET /api/roles
Axios -> Router : HTTP GET
Router -> AuthMw : authenticate()
AuthMw --> Router : req.user
Router -> PermMw : requirePermission('VIEW_STAFF')
PermMw --> Ctrl : list
Ctrl -> Svc : listRoles()
Svc -> RoleRepo : findAll() + populate permissions
DB --> RoleRepo : roles
RoleRepo --> Svc : roles
Svc --> Ctrl : [{ id, name, permissions: [...] }]
Ctrl --> Axios : 200 { data: <roles[]> }
Axios --> React : render <select> with roles

== Submit role change ==
A -> React : Pick new roleId, click "Save changes"
React -> Axios : PATCH /api/staff/:id/role  (body: { roleId })
Axios -> Router : HTTP PATCH
Router -> AuthMw : authenticate()
AuthMw --> Router : req.user attached
Router -> PermMw : requirePermission('ASSIGN_ROLE')
alt has ASSIGN_ROLE
  PermMw --> Router : next()
else
  PermMw --> Axios : 403 FORBIDDEN  "Missing permission(s): ASSIGN_ROLE"
end

Router -> ValMw : validate(assignRoleSchema)
alt valid ObjectId
  ValMw --> Ctrl : req.body.roleId parsed
else invalid
  ValMw --> Axios : 400 BAD_REQUEST  details: [{ path: "roleId" }]
end

Ctrl -> Svc : assignRole(id, roleId)

Svc -> RoleRepo : findById(roleId) + populate permissions
DB --> RoleRepo : role
alt role not found
  RoleRepo --> Svc : null
  Svc --> Ctrl : throw ApiError(400, "Role not found")
  Ctrl --> Axios : 400 BAD_REQUEST
end

Svc -> UserRepo : findById(id)
DB --> UserRepo : user
alt user not found
  UserRepo --> Svc : null
  Svc --> Ctrl : throw ApiError(404, "Staff not found")
  Ctrl --> Axios : 404 NOT_FOUND
end

Svc -> UserRepo : setRole(id, role._id)
UserRepo -> DB : findByIdAndUpdate(id, { role: role._id }, { new: true }) + populate
DB --> UserRepo : updated User
UserRepo --> Svc : User
Svc -> Svc : logger.info("Role assigned")
Svc -> Svc : toSafeJSON()
Svc --> Ctrl : safe DTO (role=ADMIN/STAFF/...)
Ctrl --> Axios : 200 { success: true, data: <safe DTO> }
Axios --> React : response
React -> A : toast.success("Staff updated") → /staff/:id

@enduml
