NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=
# Database name.  Defaults to `giaphuc` at runtime; tests override this to
# `test_giaPhuc` via tests/setup.js so test data never lands in prod.
MONGODB_DB=giaphuc

# JWT
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Email (use Gmail App Password)
MAIL_USER=
MAIL_PASS=
MAIL_FROM_NAME=Gia Phuc System

# URLs (must be set, NO localhost hard-code in code)
FRONTEND_URL=
BACKEND_URL=
